{
  "manifest_version": 2,
  "name": "Web2PDF Exact",
  "short_name": "Web2PDF",
  "version": "1.0.0",
  "description": "Convertit la page affichée en PDF identique à l'écran : rendu natif du navigateur, sans rechargement, texte sélectionnable, liens et signets.",
  "author": "Théophile Bonte",
  "homepage_url": "https://github.com/Tixeo/web2pdf-exact",
  "browser_specific_settings": {
    "gecko": {
      "id": "web2pdf-exact@extension",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "<all_urls>",
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "downloads.open",
    "menus",
    "notifications"
  ],
  "background": {
    "scripts": [
      "lib/settings.js",
      "lib/filename.js",
      "lib/glyphless-font.js",
      "lib/pdf.js",
      "lib/image.js",
      "lib/layout.js",
      "background/build.js",
      "background/background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Web2PDF Exact — convertir la page en PDF",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_browser_action": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Ouvrir Web2PDF Exact"
    },
    "capture-full": {
      "description": "Convertir la page entière en PDF (réglages par défaut)"
    },
    "capture-visible": {
      "description": "Convertir la zone visible en PDF"
    },
    "capture-element": {
      "description": "Choisir un élément à convertir en PDF"
    },
    "capture-region": {
      "description": "Tracer une zone à convertir en PDF"
    }
  }
}
