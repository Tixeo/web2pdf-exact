{
  "manifest_version": 2,
  "name": "__MSG_extName__",
  "short_name": "Web2PDF",
  "version": "1.1.0",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "author": "Théophile Bonte",
  "homepage_url": "https://github.com/Tixeo/web2pdf-exact",
  "browser_specific_settings": {
    "gecko": {
      "id": "web2pdf-exact@extension",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "<all_urls>",
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "downloads.open",
    "menus",
    "notifications"
  ],
  "background": {
    "scripts": [
      "lib/i18n.js",
      "lib/settings.js",
      "lib/filename.js",
      "lib/glyphless-font.js",
      "lib/pdf.js",
      "lib/image.js",
      "lib/layout.js",
      "background/build.js",
      "background/background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_browser_action": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "__MSG_cmdOpen__"
    },
    "capture-full": {
      "description": "__MSG_cmdFull__"
    },
    "capture-visible": {
      "description": "__MSG_cmdVisible__"
    },
    "capture-element": {
      "description": "__MSG_cmdElement__"
    },
    "capture-region": {
      "description": "__MSG_cmdRegion__"
    }
  }
}
